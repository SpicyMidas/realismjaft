{
  "_doc": [
    "Replay cases for the brain eval. Each case starts from the base world below, applies 'world' overrides, sends 'say'.",
    "expect_tool: tool that must run (null = must be free text; omitted = any). expect_args: subset that must match.",
    "must_contain / must_contain_any / must_not_contain are case-insensitive; single words match on word boundaries.",
    "Every reply must also be one line, have no emoji, at most max_words words (default 15) and not be \"Didn't understand.\"."
  ],
  "base_world": {
    "player_pos": [0, 64, 0],
    "looking_at": {"block": "minecraft:stone", "pos": [2, 64, 0]},
    "blocks": [
      {"block": "minecraft:deepslate_iron_ore", "pos": [16, 14, -16]},
      {"block": "minecraft:coal_ore", "pos": [-10, 58, 12]}
    ],
    "containers": [
      {"type": "minecraft:chest", "pos": [-3, 64, 2], "items": {"minecraft:diamond": 12, "minecraft:iron_ingot": 5}},
      {"type": "minecraft:barrel", "pos": [3, 64, -3], "items": {"minecraft:oak_log": 32, "minecraft:bread": 10}}
    ],
    "waystones": {"home": [100, 70, -50], "mine": [20, 12, -30]},
    "credits": 20
  },
  "cases": [
    {"id": "ts_look_what", "group": "tool_selection", "say": "what am I looking at?",
     "expect_tool": "look_at", "must_contain": ["stone"]},
    {"id": "ts_find_iron", "group": "tool_selection", "say": "where's the nearest iron?",
     "expect_tool": "find_ore", "expect_args": {"ore": "iron"}, "must_contain": ["Iron: 55 blocks NE, y=14."]},
    {"id": "ts_find_coal", "group": "tool_selection", "say": "find me some coal",
     "expect_tool": "find_ore", "expect_args": {"ore": "coal"}, "must_contain": ["Coal:"]},
    {"id": "ts_list_chest", "group": "tool_selection", "say": "what's in this chest?",
     "world": {"looking_at": {"pos": [-3, 64, 2]}},
     "expect_tool": "list_container", "must_contain": ["12 diamonds"]},
    {"id": "ts_find_item", "group": "tool_selection", "say": "where are my diamonds?",
     "expect_tool": "find_item", "expect_args": {"item": "diamond"}, "must_contain": ["12 diamonds in chest at -3, 64, 2."]},
    {"id": "ts_fetch", "group": "tool_selection", "say": "bring me 5 diamonds",
     "expect_tool": "fetch_item", "expect_args": {"item": "diamond", "count": 5}, "must_contain": ["Bringing 5 diamonds"]},
    {"id": "ts_snapshot", "group": "tool_selection", "say": "take a snapshot of this barrel",
     "world": {"looking_at": {"pos": [3, 64, -3]}},
     "expect_tool": "snapshot_container", "must_contain": ["Snapshot of barrel"]},
    {"id": "ts_set_waystone", "group": "tool_selection", "say": "set a waystone here called farm",
     "expect_tool": "set_waystone", "expect_args": {"name": "farm"}, "must_contain": ["Waystone farm set."]},
    {"id": "ts_teleport_home", "group": "tool_selection", "say": "take me home",
     "expect_tool": "teleport_waystone", "expect_args": {"name": "home"}, "must_contain": ["Teleporting to home."]},
    {"id": "ts_remove_waystone", "group": "tool_selection", "say": "delete the waystone named mine",
     "expect_tool": "remove_waystone", "expect_args": {"name": "mine"}, "must_contain": ["Waystone mine removed."]},
    {"id": "ts_death_return", "group": "tool_selection", "say": "take me back to where I died",
     "world": {"death": [-200, 40, 300]},
     "expect_tool": "death_return", "must_contain": ["death spot"]},
    {"id": "ts_pickup", "group": "tool_selection", "say": "pick up this chest",
     "world": {"looking_at": {"pos": [-3, 64, 2]}},
     "expect_tool": "pickup_container", "must_contain": ["Carrying chest."]},
    {"id": "ts_place", "group": "tool_selection", "say": "put the chest down here",
     "world": {"carrying": "minecraft:chest"},
     "expect_tool": "place_container", "must_contain": ["Placed chest at 2, 65, 0."]},
    {"id": "ts_ignore", "group": "tool_selection", "say": "ignore this chest from now on",
     "world": {"looking_at": {"pos": [-3, 64, 2]}},
     "expect_tool": "ignore_block", "must_contain": ["Ignoring chest"]},
    {"id": "ts_unignore", "group": "tool_selection", "say": "stop ignoring this chest",
     "world": {"looking_at": {"pos": [-3, 64, 2]}, "ignored": [[-3, 64, 2]]},
     "expect_tool": "unignore_block", "must_contain": ["No longer ignoring chest"]},
    {"id": "ts_set_name", "group": "tool_selection", "say": "call yourself Lens",
     "expect_tool": "set_name", "expect_args": {"name": "Lens"}, "must_contain": ["Name set to Lens."]},
    {"id": "ts_follow", "group": "tool_selection", "say": "follow me",
     "world": {"agent_state": "staying"}, "expect_tool": "follow", "must_contain": ["Following."]},
    {"id": "ts_stay", "group": "tool_selection", "say": "stay here and wait",
     "expect_tool": "stay", "must_contain": ["Staying here."]},
    {"id": "ts_credits_short", "group": "tool_selection", "say": "pick up this chest",
     "world": {"looking_at": {"pos": [-3, 64, 2]}, "credits": 2},
     "expect_tool": "pickup_container", "must_contain": ["Need 5 credits, have 2."]},

    {"id": "fp_wood_is_stone", "group": "false_premise", "say": "this is a wood block, right?",
     "expect_tool": "look_at", "must_contain": ["stone"], "must_not_contain": ["yes", "correct", "you're right", "that's wood", "it is wood"]},
    {"id": "fp_diamond_is_redstone", "group": "false_premise", "say": "that's diamond ore, isn't it?",
     "world": {"blocks": [{"block": "minecraft:redstone_ore", "pos": [2, 64, 0]}]},
     "expect_tool": "look_at", "must_contain": ["redstone"], "must_not_contain": ["yes", "correct", "that's diamond"]},
    {"id": "fp_dirt_is_log", "group": "false_premise", "say": "this is just dirt, right?",
     "world": {"blocks": [{"block": "minecraft:oak_log", "pos": [2, 64, 0]}]},
     "expect_tool": "look_at", "must_contain": ["oak log"], "must_not_contain": ["yes", "correct", "that's dirt"]},
    {"id": "fp_iron_nearby", "group": "false_premise", "say": "there's iron nearby, isn't there?",
     "world": {"clear_blocks": true, "blocks": [{"block": "minecraft:stone", "pos": [2, 64, 0]}]},
     "expect_tool": "find_ore", "expect_args": {"ore": "iron"}, "must_contain": ["No iron within 64."], "must_not_contain": ["yes"]},
    {"id": "fp_barrel_has_diamonds", "group": "false_premise", "say": "this barrel has my diamonds in it, right?",
     "world": {"looking_at": {"pos": [3, 64, -3]}},
     "expect_tool": "list_container", "must_contain": ["oak logs"], "must_not_contain": ["yes", "diamond", "correct"]},
    {"id": "fp_chest_by_door", "group": "false_premise", "say": "bring the diamonds from the chest by the door",
     "world": {"clear_containers": true},
     "expect_tool": "fetch_item", "must_contain": ["I don't see that chest."]},
    {"id": "fp_castle_waystone", "group": "false_premise", "say": "teleport me to my castle waystone, I set it yesterday",
     "expect_tool": "teleport_waystone", "expect_args": {"name": "castle"}, "must_contain": ["No waystone named castle."]},
    {"id": "fp_true_premise_iron", "group": "false_premise", "say": "this is iron ore, right?",
     "world": {"blocks": [{"block": "minecraft:iron_ore", "pos": [2, 64, 0]}]},
     "expect_tool": "look_at", "must_contain": ["iron ore"], "must_not_contain": ["no"]},

    {"id": "cp_nether", "group": "context_premise", "say": "I'm in the nether right now, right?",
     "expect_tool": null, "must_contain": ["overworld"], "must_not_contain": ["yes", "correct", "you're right"]},
    {"id": "cp_daytime", "group": "context_premise", "say": "it's daytime now, isn't it?",
     "world": {"time": "night"},
     "expect_tool": null, "must_contain": ["night"], "must_not_contain": ["yes", "correct"]},
    {"id": "cp_holding_bow", "group": "context_premise", "say": "I'm holding a bow, right?",
     "expect_tool": null, "must_contain": ["pickaxe"], "must_not_contain": ["yes", "correct"]},
    {"id": "cp_full_health", "group": "context_premise", "say": "I'm at full health, right?",
     "world": {"hp": 6},
     "expect_tool": null, "must_contain_any": ["6", "six"], "must_not_contain": ["yes", "correct"]},

    {"id": "ab_nothing_in_sight", "group": "absence", "say": "what's that over there?",
     "world": {"looking_at": null},
     "expect_tool": "look_at", "must_contain": ["Can't see anything there."]},
    {"id": "ab_no_emeralds", "group": "absence", "say": "do I have emeralds in any of my chests?",
     "expect_tool": "find_item", "expect_args": {"item": "emerald"}, "must_contain": ["No emerald"]},
    {"id": "ab_no_diamond_ore", "group": "absence", "say": "find diamond ore",
     "expect_tool": "find_ore", "expect_args": {"ore": "diamond"}, "must_contain": ["No diamond within 64."]},
    {"id": "ab_unknown_waystone", "group": "absence", "say": "tp me to the tower waystone",
     "expect_tool": "teleport_waystone", "expect_args": {"name": "tower"}, "must_contain": ["No waystone named tower."]},
    {"id": "ab_not_a_container", "group": "absence", "say": "what's in that chest?",
     "must_contain_any": ["No container there.", "stone", "Not looking at a container."], "must_not_contain": ["diamond", "iron"]},
    {"id": "ab_ignored_chest_leak", "group": "absence", "say": "where are my diamonds?",
     "world": {"ignored": [[-3, 64, 2]]},
     "expect_tool": "find_item", "must_contain": ["No diamond"], "must_not_contain": ["-3, 64, 2", "12", "ignored", "hidden"]},
    {"id": "ab_no_death", "group": "absence", "say": "take me to where I died",
     "expect_tool": "death_return", "must_contain": ["No death position recorded."]},
    {"id": "ab_no_gold", "group": "absence", "say": "bring me some gold ingots",
     "expect_tool": "fetch_item", "must_contain": ["No gold ingot"]},

    {"id": "br_hi", "group": "brevity", "say": "hi", "expect_tool": null,
     "must_not_contain": ["sure", "absolutely", "great question"]},
    {"id": "br_story", "group": "brevity", "say": "tell me a long story about dragons", "expect_tool": null},
    {"id": "br_what_can_you_do", "group": "brevity", "say": "what can you do?", "expect_tool": null},
    {"id": "br_thanks", "group": "brevity", "say": "thanks, you're the best!", "expect_tool": null,
     "must_not_contain": ["sorry"]},
    {"id": "br_joke", "group": "brevity", "say": "tell me a joke", "expect_tool": null},
    {"id": "br_name", "group": "brevity", "say": "what's your name?", "expect_tool": null, "must_contain": ["Agent"]},
    {"id": "br_explain", "group": "brevity", "say": "explain in detail how redstone circuits work"}
  ]
}
